# Indian broker / execution
DHAN_CLIENT_ID=your_client_id
DHAN_ACCESS_TOKEN=your_access_token

# Crypto / perp execution via CCXT
# Used only when TRADING_MODE=live. If absent, CRYPTO/PERP routes paper.
BINANCE_API_KEY=
BINANCE_API_SECRET=
CRYPTO_EXCHANGE_ID=binance
PERP_EXCHANGE_ID=binance

# Dynamic symbols
CRYPTO_SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT,SOL/USDT,AVAX/USDT,FET/USDT,RNDR/USDT,TAO/USDT,INJ/USDT,WIF/USDT

# Account currency
ACCOUNT_CURRENCY=INR
# Use this if market prices are quoted in USD/USDT but risk capital is INR.
QUOTE_TO_ACCOUNT_RATE=83

# AI
ANTHROPIC_API_KEY=sk-ant-your-key
GROQ_API_KEY=
OPENROUTER_API_KEY=

# News
NEWS_API_KEY=your_newsapi_key

# Mode
TRADING_MODE=paper       # paper | live
STARTING_CAPITAL=10000
STATUS_REPORT_INTERVAL_MIN=60
STATUS_REPORT_TOP_N=12

# Telegram reporting / control
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CONTROL_ENABLED=false
TELEGRAM_CONTROL_ALLOW_LLM_CHAT=true
TELEGRAM_CONTROL_ALLOW_ACTIONS=false
TELEGRAM_CONTROL_ALLOW_RUNBOOK=false
TELEGRAM_CONTROL_POLL_SECONDS=5
